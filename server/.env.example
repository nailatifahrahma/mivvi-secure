# Optional path to a different rules configuration file
# MIVVI_RULES_FILE=/absolute/path/to/rules.json

# Required to send registration verification codes by email (SMTP + STARTTLS).
# Port 465 uses implicit TLS. Keep secrets in your local environment, not in Git.
# MIVVI_SMTP_HOST=smtp.example.com
# MIVVI_SMTP_PORT=587
# MIVVI_SMTP_USER=account@example.com
# MIVVI_SMTP_PASSWORD=app-password
# MIVVI_SMTP_FROM=account@example.com
